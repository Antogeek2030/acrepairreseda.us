---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Page Not Found | Air Conditioning Repair Reseda CA";
const description = "The page you are looking for could not be found.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="py-20 md:py-28 text-center">
    <div class="max-w-xl mx-auto px-4">
      <p class="text-6xl font-bold text-primary-600 mb-4">404</p>
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Page Not Found</h1>
      <p class="text-gray-600 mb-8">Sorry, we couldn’t find the page you’re looking for. It may have been moved or no longer exists.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">Go to Homepage</a>
        <a href="/contact/" class="btn-secondary">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
