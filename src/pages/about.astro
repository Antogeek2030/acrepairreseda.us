---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "About Us | Air Conditioning Repair Reseda CA";
const description = "Learn about our local HVAC team serving Reseda and the San Fernando Valley with honest, professional air conditioning and heating service.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-primary-700 text-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">About Air Conditioning Repair Reseda CA</h1>
      <p class="text-xl text-primary-100">A local team focused on clear communication, reliable work, and comfortable homes across the San Fernando Valley.</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-lg max-w-none">
      <p>
        We are a local HVAC service dedicated to the Reseda area and nearby neighborhoods. Our approach is straightforward: diagnose accurately, explain options in plain language, and perform the work carefully so your system runs as it should.
      </p>
      <p>
        Southern California’s climate places heavy seasonal demands on air conditioning systems. We understand the equipment common in local homes, the challenges of older ductwork, and the importance of responsive service when temperatures climb.
      </p>
      <h2>What Guides Our Work</h2>
      <ul>
        <li><strong>Honesty</strong> — We recommend only the repairs or upgrades that make sense for your situation and budget.</li>
        <li><strong>Respect</strong> — We treat your home carefully, keep work areas tidy, and communicate clearly about timing and next steps.</li>
        <li><strong>Reliability</strong> — When we schedule a visit, we show up prepared and follow through on the commitments we make.</li>
        <li><strong>Local focus</strong> — Serving Reseda, Tarzana, Northridge, Canoga Park, Encino, and surrounding communities means shorter response times and better familiarity with the area.</li>
      </ul>
      <h2>How We Can Help</h2>
      <p>
        From emergency AC repairs and furnace service to new system installations, maintenance plans, and indoor air quality improvements, we handle the full range of residential and light-commercial HVAC needs. If you have questions about your system or want a second opinion, we are happy to talk.
      </p>
      <p>
        Ready to experience responsive local service? Call us at <a href="tel:+16073400658">(607) 340-0658</a> or <a href="/contact/">send a message</a>. We look forward to helping you stay comfortable.
      </p>
    </div>
  </section>
</BaseLayout>
