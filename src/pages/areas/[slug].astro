---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: CollectionEntry<'areas'>;
}

const { area } = Astro.props;
const { Content } = await area.render();

const title = `HVAC Services in ${area.data.neighborhood}, CA | Air Conditioning Repair Reseda CA`;
const description = area.data.description;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="bg-primary-700 text-white py-12 md:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-sm text-primary-200 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white">Home</a>
          <span class="mx-2">/</span>
          <a href="/service-areas/" class="hover:text-white">Service Areas</a>
          <span class="mx-2">/</span>
          <span class="text-white">{area.data.neighborhood}</span>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold mb-4">HVAC Services in {area.data.neighborhood}</h1>
        <p class="text-xl text-primary-100">{area.data.shortDescription}</p>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="prose prose-lg prose-primary max-w-none">
        <Content />
      </div>
      
      <div class="mt-12 p-8 bg-primary-50 rounded-2xl border border-primary-100 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Need Service in {area.data.neighborhood}?</h2>
        <p class="text-gray-600 mb-6">Call us today or request a free quote. We’re ready to help restore your comfort.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+16073400658" class="btn-primary">Call (607) 340-0658</a>
          <a href="/contact/" class="btn-secondary">Request a Quote</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
