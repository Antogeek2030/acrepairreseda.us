---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Contact Us | Air Conditioning Repair Reseda CA";
const description = "Request a free quote or schedule HVAC service in Reseda, CA. Call (607) 340-0658 or use our contact form. We respond promptly.";
const accessKey = "YOUR_WEB3FORMS_ACCESS_KEY"; // Replace with your Web3Forms access key
---

<BaseLayout title={title} description={description}>
  <section class="bg-primary-700 text-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Contact Us</h1>
      <p class="text-xl text-primary-100">Reach out for a free quote, service appointment, or questions about your HVAC system. We respond as quickly as possible.</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Get in Touch</h2>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Phone</h3>
                <a href="tel:+16073400658" class="text-primary-600 hover:underline text-lg">(607) 340-0658</a>
                <p class="text-sm text-gray-500 mt-1">Call for fastest response, especially for emergencies</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Address</h3>
                <p class="text-gray-700">7920 Etiwanda Ave<br>Reseda, CA 91335, USA</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Hours</h3>
                <p class="text-gray-700">Monday – Saturday: 7:00 AM – 7:00 PM<br>Sunday: Emergency service available</p>
              </div>
            </div>
          </div>
        </div>
        
        <div>
          <div id="form-container">
            <form
              id="contact-form"
              action="https://api.web3forms.com/submit"
              method="POST"
              class="bg-white p-6 md:p-8 rounded-2xl border border-gray-200 shadow-sm space-y-5"
            >
              <input type="hidden" name="access_key" value={accessKey} />
              <input type="hidden" name="subject" value="New Contact Form Submission - Air Conditioning Repair Reseda CA" />
              <input type="hidden" name="from_name" value="Website Contact Form" />
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />
              
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" />
              </div>
              
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone <span class="text-red-500">*</span></label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" />
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" />
              </div>
              
              <div>
                <label for="service" class="block text-sm font-medium text-gray-700 mb-1">Service Needed</label>
                <select id="service" name="service" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition">
                  <option value="">Select a service...</option>
                  <option value="AC Repair">AC Repair</option>
                  <option value="AC Installation">AC Installation</option>
                  <option value="Furnace Repair">Furnace Repair</option>
                  <option value="Maintenance">Maintenance / Tune-Up</option>
                  <option value="Other">Other / Not Sure</option>
                </select>
              </div>
              
              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message <span class="text-red-500">*</span></label>
                <textarea id="message" name="message" rows="4" required class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition" placeholder="Describe the issue or what you need help with..."></textarea>
              </div>
              
              <button type="submit" class="w-full btn-primary py-3 text-lg" id="submit-btn">
                Send Message
              </button>
              
              <p class="text-xs text-gray-500 text-center">
                By submitting, you agree to be contacted regarding your request. We respect your privacy.
              </p>
            </form>
          </div>
          
          <div id="thank-you" class="hidden bg-green-50 border border-green-200 rounded-2xl p-8 text-center">
            <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Thank You!</h2>
            <p class="text-gray-600 mb-6">Your message has been sent. We’ll get back to you as soon as possible. For urgent needs, please call us directly.</p>
            <a href="tel:+16073400658" class="btn-primary">Call (607) 340-0658</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formContainer = document.getElementById('form-container');
  const thankYou = document.getElementById('thank-you');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      const formData = new FormData(form);
      
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
        });
        
        const data = await response.json();
        
        if (data.success) {
          formContainer?.classList.add('hidden');
          thankYou?.classList.remove('hidden');
        } else {
          alert('Something went wrong. Please try again or call us directly.');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }
      } catch (error) {
        alert('Unable to send message. Please call us at (607) 340-0658.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    });
  }
</script>
