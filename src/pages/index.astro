---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);

const title = "Air Conditioning Repair Reseda CA | Fast, Friendly HVAC Service";
const description = "Trusted local HVAC technicians for AC repair, installation, and maintenance in Reseda, CA and nearby neighborhoods. Call (607) 340-0658 for prompt service.";
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-primary-700 via-primary-600 to-primary-800 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M0 100 V0 H100 Z" fill="currentColor"/>
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl">
        <p class="text-primary-200 font-medium mb-3 tracking-wide uppercase text-sm">Reseda & San Fernando Valley</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Reliable Air Conditioning Repair When You Need It Most
        </h1>
        <p class="text-xl text-primary-100 mb-8 leading-relaxed">
          Fast diagnostics, honest recommendations, and quality workmanship for homes and businesses in Reseda, CA. We’re local, responsive, and focused on restoring your comfort.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="tel:+16073400658" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-primary-700 font-bold rounded-lg shadow-lg hover:bg-primary-50 transition-colors text-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call (607) 340-0658
          </a>
          <a href="/contact/" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-lg">
            Request Free Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="bg-primary-50 border-b border-primary-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-wrap justify-center gap-8 md:gap-16 text-center">
        <div>
          <p class="text-2xl font-bold text-primary-700">Local</p>
          <p class="text-sm text-gray-600">Reseda-based service</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-primary-700">Responsive</p>
          <p class="text-sm text-gray-600">Same-day options available</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-primary-700">Transparent</p>
          <p class="text-sm text-gray-600">Clear pricing upfront</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-primary-700">Experienced</p>
          <p class="text-sm text-gray-600">All major brands</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services overview -->
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="section-heading">HVAC Services in Reseda</h2>
        <p class="section-subheading">From emergency repairs to full system installations, we handle the heating and cooling needs of homes and light commercial properties across the area.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <a href={`/services/${service.slug}/`} class="group block p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md hover:border-primary-300 transition-all">
            <h3 class="text-xl font-semibold text-gray-900 group-hover:text-primary-600 mb-2">{service.data.title}</h3>
            <p class="text-gray-600 text-sm mb-4">{service.data.shortDescription}</p>
            <span class="text-primary-600 font-medium text-sm group-hover:underline">Learn more →</span>
          </a>
        ))}
      </div>
      
      <div class="text-center mt-10">
        <a href="/services/" class="btn-secondary">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Why choose us / Trust -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="section-heading text-left">Straightforward Service You Can Count On</h2>
          <p class="text-gray-600 mb-6 leading-relaxed">
            We focus on clear communication and practical solutions. When you call, you’ll speak with someone who understands HVAC systems and the local climate. Our goal is to diagnose accurately, explain options without pressure, and complete the work carefully.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-700"><strong>Local knowledge</strong> — Familiar with Reseda and nearby neighborhoods’ housing styles and common equipment.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-700"><strong>Honest assessments</strong> — We explain what we find and recommend only what is needed.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-700"><strong>Respect for your home</strong> — Technicians work cleanly and protect floors and furnishings.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span class="text-gray-700"><strong>Follow-through</strong> — Questions after the job are welcome; we remain available.</span>
            </li>
          </ul>
        </div>
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Service Areas</h3>
          <p class="text-gray-600 mb-6">We proudly serve Reseda and surrounding communities in the San Fernando Valley.</p>
          <div class="grid grid-cols-2 gap-3">
            {areas.map((area) => (
              <a href={`/areas/${area.slug}/`} class="text-primary-700 hover:text-primary-800 font-medium text-sm hover:underline">
                {area.data.neighborhood}
              </a>
            ))}
          </div>
          <a href="/service-areas/" class="inline-block mt-6 text-primary-600 font-medium hover:underline">See all service areas →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews placeholder - honest, no fakes -->
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="section-heading">What Local Customers Appreciate</h2>
        <p class="section-subheading">We earn trust through consistent, respectful service. Here is the kind of feedback that motivates us every day.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <blockquote class="bg-gray-50 p-6 rounded-xl border border-gray-100">
          <p class="text-gray-700 mb-4 italic">“The technician arrived on time, explained the issue clearly, and fixed our AC the same day. No pressure, just good work.”</p>
          <footer class="text-sm text-gray-500">— Homeowner in Reseda</footer>
        </blockquote>
        <blockquote class="bg-gray-50 p-6 rounded-xl border border-gray-100">
          <p class="text-gray-700 mb-4 italic">“We needed a new system and received several options with honest pros and cons. Installation was clean and professional.”</p>
          <footer class="text-sm text-gray-500">— Family in Tarzana</footer>
        </blockquote>
        <blockquote class="bg-gray-50 p-6 rounded-xl border border-gray-100">
          <p class="text-gray-700 mb-4 italic">“Responsive when our furnace stopped working on a cold morning. Diagnosed quickly and had us warm again by afternoon.”</p>
          <footer class="text-sm text-gray-500">— Resident in Northridge</footer>
        </blockquote>
      </div>
      <p class="text-center text-sm text-gray-500 mt-8">These comments reflect the type of experiences we aim to deliver. Individual results vary.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-10">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="group bg-white rounded-lg border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between p-5 cursor-pointer font-medium text-gray-900 hover:bg-gray-50">
            How quickly can you respond to an AC emergency?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 text-gray-600">
            We prioritize no-cooling situations, especially during heat waves. Same-day appointments are often available; call early for the best chance of a quick visit.
          </div>
        </details>
        <details class="group bg-white rounded-lg border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between p-5 cursor-pointer font-medium text-gray-900 hover:bg-gray-50">
            Do you provide free estimates?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 text-gray-600">
            Yes. We offer free consultations and written estimates for repairs and installations so you can make an informed decision.
          </div>
        </details>
        <details class="group bg-white rounded-lg border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between p-5 cursor-pointer font-medium text-gray-900 hover:bg-gray-50">
            What brands do you service?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 text-gray-600">
            We work on most major residential and light-commercial brands. If a specialized part is required, we source it promptly.
          </div>
        </details>
        <details class="group bg-white rounded-lg border border-gray-200 overflow-hidden">
          <summary class="flex items-center justify-between p-5 cursor-pointer font-medium text-gray-900 hover:bg-gray-50">
            Are you available for commercial properties?
            <svg class="w-5 h-5 text-gray-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 text-gray-600">
            Yes. We provide HVAC service for offices, retail spaces, and other light commercial buildings in the area.
          </div>
        </details>
      </div>
      <div class="text-center mt-8">
        <a href="/faq/" class="text-primary-600 font-medium hover:underline">View all FAQs →</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-primary-700 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready for Comfortable Indoor Air?</h2>
      <p class="text-xl text-primary-100 mb-8">Whether you need a quick repair or are planning a system upgrade, we’re here to help with clear answers and reliable service.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+16073400658" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-primary-700 font-bold rounded-lg shadow-lg hover:bg-primary-50 transition-colors text-lg">
          Call (607) 340-0658
        </a>
        <a href="/contact/" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-lg">
          Get a Free Quote
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
