---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);

const title = "Service Areas | HVAC Service in Reseda & Nearby Neighborhoods";
const description = "We provide air conditioning repair, installation, and HVAC maintenance throughout Reseda, Tarzana, Northridge, Canoga Park, Encino, and other San Fernando Valley communities.";
---

<BaseLayout title={title} description={description}>
  <section class="bg-primary-700 text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">Service Areas</h1>
      <p class="text-xl text-primary-100 max-w-3xl">Local HVAC service focused on Reseda and the surrounding San Fernando Valley. Fast response times and familiarity with the area’s homes and climate.</p>
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {areas.map((area) => (
          <a href={`/areas/${area.slug}/`} class="group block p-6 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md hover:border-primary-300 transition-all">
            <h2 class="text-xl font-semibold text-gray-900 group-hover:text-primary-600 mb-2">{area.data.neighborhood}</h2>
            <p class="text-gray-600 text-sm mb-4">{area.data.shortDescription}</p>
            <span class="text-primary-600 font-medium text-sm group-hover:underline">View services in {area.data.neighborhood} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Don’t See Your Neighborhood?</h2>
      <p class="text-gray-600 mb-6">We often serve additional nearby communities. Call us to confirm availability for your address.</p>
      <a href="tel:+16073400658" class="btn-primary">Call (607) 340-0658</a>
    </div>
  </section>
</BaseLayout>
