---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Terms of Service | Air Conditioning Repair Reseda CA";
const description = "Terms of service for airconditioningrepairresedaca.us and our HVAC services in Reseda, CA.";
---

<BaseLayout title={title} description={description}>
  <section class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose prose-lg max-w-none">
      <h1>Terms of Service</h1>
      <p class="text-gray-500">Last updated: November 2025</p>
      
      <p>By accessing the website airconditioningrepairresedaca.us or engaging our services, you agree to these terms.</p>
      
      <h2>Services</h2>
      <p>We provide HVAC repair, installation, and maintenance services in Reseda, CA and nearby areas. Specific work is governed by written estimates and invoices provided at the time of service.</p>
      
      <h2>Estimates and Pricing</h2>
      <p>Estimates are provided in good faith based on the information available at the time. Final pricing may vary if additional issues are discovered or if the scope of work changes. We will communicate any material changes before proceeding.</p>
      
      <h2>Website Content</h2>
      <p>Content on this website is for general informational purposes. It does not constitute professional advice for your specific situation. Always consult a qualified technician for diagnosis and recommendations regarding your equipment.</p>
      
      <h2>Limitation of Liability</h2>
      <p>To the fullest extent permitted by law, we are not liable for indirect, incidental, or consequential damages arising from use of the website or our services beyond the amounts paid for specific work performed.</p>
      
      <h2>Governing Law</h2>
      <p>These terms are governed by the laws of the State of California.</p>
      
      <h2>Contact</h2>
      <p>Questions about these terms may be directed to us at (607) 340-0658 or via our <a href="/contact/">contact form</a>.</p>
    </div>
  </section>
</BaseLayout>
